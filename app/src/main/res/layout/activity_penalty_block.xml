<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/bg_deep"
    android:padding="32dp">

    <!-- Grid BG -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_grid"
        android:alpha="0.3"
        android:layout_gravity="center"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🚫"
        android:textSize="72sp"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ACCÈS BLOQUÉ"
        android:fontFamily="sans-serif"
        android:textSize="22sp"
        android:textColor="@color/neon_red"
        android:letterSpacing="0.15"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tu as une pénalité active.\nComplète une session de focus pour débloquer tes jeux."
        android:fontFamily="sans-serif"
        android:textSize="15sp"
        android:textColor="@color/text_muted"
        android:gravity="center"
        android:lineSpacingMultiplier="1.6"
        android:layout_marginBottom="40dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGoFocus"
        style="@style/ButtonPrimary"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="▶ FAIRE MON FOCUS MAINTENANT"/>

</LinearLayout>
