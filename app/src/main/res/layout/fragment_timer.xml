<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HERO SECTION -->
        <LinearLayout
            android:id="@+id/heroSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_timer_hero"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <!-- Mode Tabs: FOCUS / PAUSE -->
            <LinearLayout
                android:id="@+id/modeTabs"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_mode_tabs_container"
                android:orientation="horizontal"
                android:padding="4dp"
                android:layout_marginBottom="28dp">

                <TextView
                    android:id="@+id/tabFocus"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="FOCUS"
                    android:fontFamily="sans-serif-black"
                    android:textSize="12sp"
                    android:letterSpacing="0.1"
                    android:gravity="center"
                    android:background="@drawable/bg_mode_tab_active"
                    android:textColor="@color/neon_cyan"/>

                <TextView
                    android:id="@+id/tabPause"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="PAUSE"
                    android:fontFamily="sans-serif-black"
                    android:textSize="12sp"
                    android:letterSpacing="0.1"
                    android:gravity="center"
                    android:background="@color/transparent"
                    android:textColor="@color/text_muted"/>

            </LinearLayout>

            <!-- Circular Timer Ring -->
            <FrameLayout
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp">

                <!-- Custom Ring View -->
                <com.mikhaellopez.circularprogressbar.CircularProgressBar
                    android:id="@+id/circularProgressBar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>

                <!-- Inner content -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="30dp">

                    <TextView
                        android:id="@+id/tvTimerDisplay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="25:00"
                        android:fontFamily="sans-serif"
                        android:textSize="44sp"
                        android:textColor="@color/text_primary"
                        android:letterSpacing="-0.03"
                        android:includeFontPadding="false"/>

                    <TextView
                        android:id="@+id/tvPhaseLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TEMPS DE FOCUS"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="10sp"
                        android:textColor="@color/neon_cyan"
                        android:letterSpacing="0.25"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:id="@+id/tvSessionCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Session 1 / 4"
                        android:textSize="11sp"
                        android:textColor="@color/text_muted"
                        android:layout_marginTop="6dp"/>

                </LinearLayout>
            </FrameLayout>

            <!-- Controls Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal">

                <!-- Reset btn -->
                <ImageButton
                    android:id="@+id/btnReset"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_ctrl_btn"
                    android:src="@drawable/ic_reset"
                    android:scaleType="center"
                    android:contentDescription="Reset"/>

                <!-- Play/Pause btn -->
                <ImageButton
                    android:id="@+id/btnPlay"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_play_btn"
                    android:src="@drawable/ic_play"
                    android:scaleType="center"
                    android:contentDescription="Play/Pause"/>

                <!-- Fullscreen / Focus Mode btn -->
                <ImageButton
                    android:id="@+id/btnFocusMode"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_ctrl_btn"
                    android:src="@drawable/ic_fullscreen"
                    android:scaleType="center"
                    android:contentDescription="Focus Mode"/>

            </LinearLayout>

        </LinearLayout>

        <!-- STATS ROW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/bg_card"
            android:weightSum="3">

            <!-- Sessions -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="@drawable/bg_stat_cell">

                <TextView
                    android:id="@+id/tvStatSessions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:fontFamily="sans-serif-bold"
                    android:textSize="22sp"
                    android:textColor="@color/neon_cyan"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sessions_today"
                    android:textSize="12sp"
                    android:textColor="@color/text_muted"
                    android:layout_marginTop="2dp"/>

            </LinearLayout>

            <!-- XP Today -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="@drawable/bg_stat_cell">

                <TextView
                    android:id="@+id/tvStatXp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+0"
                    android:fontFamily="sans-serif-bold"
                    android:textSize="22sp"
                    android:textColor="@color/neon_gold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/xp_today"
                    android:textSize="12sp"
                    android:textColor="@color/text_muted"
                    android:layout_marginTop="2dp"/>

            </LinearLayout>

            <!-- Focus Total -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/tvStatTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0m"
                    android:fontFamily="sans-serif-bold"
                    android:textSize="22sp"
                    android:textColor="@color/neon_green"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/focus_total"
                    android:textSize="12sp"
                    android:textColor="@color/text_muted"
                    android:layout_marginTop="2dp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- DIVIDER -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_subtle"/>

        <!-- SECTION LABEL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PERSONNALISATION"
            android:fontFamily="sans-serif-black"
            android:textSize="11sp"
            android:letterSpacing="0.25"
            android:textColor="@color/text_muted"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="8dp"/>

        <!-- CUSTOMIZE PANEL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/bg_card"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- Focus Duration Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="⏱ Durée Focus"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageButton
                        android:id="@+id/btnFocusMinus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_step_btn"
                        android:src="@drawable/ic_minus"
                        android:scaleType="center"/>

                    <TextView
                        android:id="@+id/tvFocusDuration"
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:text="25 min"
                        android:fontFamily="sans-serif-bold"
                        android:textSize="15sp"
                        android:textColor="@color/neon_cyan"
                        android:gravity="center"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:background="?attr/selectableItemBackground"
                        android:padding="4dp"/>

                    <ImageButton
                        android:id="@+id/btnFocusPlus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_step_btn"
                        android:src="@drawable/ic_plus"
                        android:scaleType="center"/>

                </LinearLayout>
            </LinearLayout>

            <!-- Pause Duration Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="☕ Durée Pause"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageButton
                        android:id="@+id/btnBreakMinus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_step_btn"
                        android:src="@drawable/ic_minus"
                        android:scaleType="center"/>

                    <TextView
                        android:id="@+id/tvBreakDuration"
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:text="5 min"
                        android:fontFamily="sans-serif-bold"
                        android:textSize="15sp"
                        android:textColor="@color/neon_cyan"
                        android:gravity="center"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:background="?attr/selectableItemBackground"
                        android:padding="4dp"/>

                    <ImageButton
                        android:id="@+id/btnBreakPlus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_step_btn"
                        android:src="@drawable/ic_plus"
                        android:scaleType="center"/>

                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="24dp"/>

    </LinearLayout>
</ScrollView>
