<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- SECTION CHRONO -->
        <LinearLayout
            android:id="@+id/heroSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_timer_hero"
            android:padding="24dp">

            <LinearLayout
                android:id="@+id/modeTabs"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_mode_tabs_container"
                android:orientation="horizontal"
                android:padding="4dp"
                android:layout_marginBottom="28dp">
                <TextView android:id="@+id/tabFocus" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="FOCUS" android:fontFamily="sans-serif-black" android:textSize="12sp" android:gravity="center" android:background="@drawable/bg_mode_tab_active" android:textColor="@color/neon_cyan"/>
                <TextView android:id="@+id/tabPause" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="PAUSE" android:fontFamily="sans-serif-black" android:textSize="12sp" android:gravity="center" android:textColor="@color/text_muted"/>
            </LinearLayout>

            <FrameLayout
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp">
                <com.mikhaellopez.circularprogressbar.CircularProgressBar
                    android:id="@+id/circularProgressBar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView android:id="@+id/tvTimerDisplay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="25:00" android:textSize="44sp" android:textColor="@color/white" android:fontFamily="sans-serif-bold"/>
                    <TextView android:id="@+id/tvPhaseLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TEMPS DE FOCUS" android:textSize="10sp" android:textColor="@color/neon_cyan" android:layout_marginTop="4dp"/>
                    <TextView android:id="@+id/tvSessionCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Session 1 / 4" android:textSize="11sp" android:textColor="@color/text_muted" android:layout_marginTop="6dp"/>
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">
                <ImageButton android:id="@+id/btnReset" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_ctrl_btn" android:src="@drawable/ic_reset" android:contentDescription="Reset"/>
                <ImageButton android:id="@+id/btnPlay" android:layout_width="72dp" android:layout_height="72dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:background="@drawable/bg_play_btn" android:src="@drawable/ic_play" android:contentDescription="Play"/>
                <ImageButton android:id="@+id/btnFocusMode" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_ctrl_btn" android:src="@drawable/ic_fullscreen" android:contentDescription="Mode"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSkipPause"
                style="@style/ButtonSecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:text="ZAPPER LA PAUSE ⏩"
                android:textColor="@color/white"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- SECTION STATS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/bg_card"
            android:weightSum="3">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="14dp" android:background="@drawable/bg_stat_cell">
                <TextView android:id="@+id/tvStatSessions" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:fontFamily="sans-serif-bold" android:textSize="22sp" android:textColor="@color/neon_cyan"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sessions" android:textSize="12sp" android:textColor="@color/text_muted"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="14dp" android:background="@drawable/bg_stat_cell">
                <TextView android:id="@+id/tvStatXp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+0" android:fontFamily="sans-serif-bold" android:textSize="22sp" android:textColor="@color/neon_gold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="XP Aujourd'hui" android:textSize="12sp" android:textColor="@color/text_muted"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="14dp">
                <TextView android:id="@+id/tvStatTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0m" android:fontFamily="sans-serif-bold" android:textSize="22sp" android:textColor="@color/neon_green"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Total" android:textSize="12sp" android:textColor="@color/text_muted"/>
            </LinearLayout>
        </LinearLayout>

        <!-- SECTION PERSONNALISATION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/bg_card"
            android:padding="20dp"
            android:layout_marginTop="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="20dp">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="⏱ Durée Focus" android:textColor="@color/text_primary" android:textSize="14sp"/>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageButton android:id="@+id/btnFocusMinus" android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/bg_step_btn" android:src="@drawable/ic_minus" android:contentDescription="Minus"/>
                    <TextView android:id="@+id/tvFocusDuration" android:layout_width="64dp" android:layout_height="wrap_content" android:text="25 min" android:textColor="@color/neon_cyan" android:gravity="center" android:textStyle="bold" android:textSize="15sp"/>
                    <ImageButton android:id="@+id/btnFocusPlus" android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/bg_step_btn" android:src="@drawable/ic_plus" android:contentDescription="Plus"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="☕ Durée Pause" android:textColor="@color/text_primary" android:textSize="14sp"/>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageButton android:id="@+id/btnBreakMinus" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_step_btn" android:src="@drawable/ic_minus" android:contentDescription="Minus"/>
                    <TextView android:id="@+id/tvBreakDuration" android:layout_width="64dp" android:layout_height="wrap_content" android:text="5 min" android:textColor="@color/neon_cyan" android:gravity="center" android:textStyle="bold" android:textSize="15sp"/>
                    <ImageButton android:id="@+id/btnBreakPlus" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_step_btn" android:src="@drawable/ic_plus" android:contentDescription="Plus"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
