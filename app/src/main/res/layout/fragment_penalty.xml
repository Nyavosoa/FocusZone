<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Status Header (Penalty vs No Penalty) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Penalty Active State -->
            <LinearLayout
                android:id="@+id/penaltyActiveState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_penalty_banner"
                android:layout_margin="16dp"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚫"
                    android:textSize="40sp"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PÉNALITÉ ACTIVE"
                    android:fontFamily="sans-serif-black"
                    android:textSize="16sp"
                    android:textColor="@color/neon_red"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:id="@+id/tvPenaltyDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tu as manqué tes objectifs.\nTes jeux cochés sont bloqués."
                    android:textSize="13sp"
                    android:textColor="#CCFF6B83"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.5"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartFocusPenalty"
                    style="@style/ButtonPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:text="▶ RÉPARER AVEC UN FOCUS"
                    android:textColor="@color/white" />
            </LinearLayout>

            <!-- No Penalty State -->
            <LinearLayout
                android:id="@+id/noPenaltyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@color/bg_card"
                android:layout_margin="16dp"
                android:padding="30dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛡️"
                    android:textSize="48sp"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AUCUNE PÉNALITÉ"
                    android:fontFamily="sans-serif-black"
                    android:textSize="14sp"
                    android:textColor="@color/neon_green"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tes jeux sont actuellement accessibles."
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
        </FrameLayout>

        <!-- DISCIPLINE SETTINGS SECTION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RÉGLAGES DE DISCIPLINE"
            android:fontFamily="sans-serif-black"
            android:textSize="11sp"
            android:letterSpacing="0.25"
            android:textColor="@color/text_muted"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/bg_card"
            android:padding="20dp">

            <!-- Check Hour Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Heure de vérification"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/tvCheckHour"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20:00"
                    android:textColor="@color/neon_cyan"
                    android:textStyle="bold"
                    android:background="@drawable/bg_stat_cell"
                    android:padding="8dp"/>
            </LinearLayout>

            <!-- Default Focus Duration -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Focus par défaut"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/tvDefaultFocus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="25 min"
                    android:textColor="@color/neon_cyan"
                    android:textStyle="bold"
                    android:background="@drawable/bg_stat_cell"
                    android:padding="8dp"/>
            </LinearLayout>

            <!-- Default Pause Duration -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Pause par défaut"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/tvDefaultBreak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5 min"
                    android:textColor="@color/neon_cyan"
                    android:textStyle="bold"
                    android:background="@drawable/bg_stat_cell"
                    android:padding="8dp"/>
            </LinearLayout>

            <!-- Ringtone Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Sonnerie de mission"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickRingtone"
                    style="@style/ButtonSecondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CHOISIR"
                    android:textSize="11sp"
                    android:textColor="@color/white" />
            </LinearLayout>

            <!-- App Selection Row -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectApps"
                style="@style/ButtonSecondary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="📦 SÉLECTIONNER LES JEUX À BLOQUER"
                android:textColor="@color/white"
                app:icon="@drawable/ic_edit"
                app:iconTint="@color/white"
                app:iconGravity="textStart"/>

        </LinearLayout>

        <!-- Current Blocked Apps Preview -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LISTE DE BLOCAGE ACTUELLE"
            android:fontFamily="sans-serif-black"
            android:textSize="11sp"
            android:letterSpacing="0.25"
            android:textColor="@color/text_muted"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="8dp"/>

        <LinearLayout
            android:id="@+id/blockedAppsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"/>

    </LinearLayout>
</ScrollView>
