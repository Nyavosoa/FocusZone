<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Penalty Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_penalty_banner"
            android:layout_margin="16dp"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚫"
                android:textSize="40sp"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PÉNALITÉ ACTIVE"
                android:fontFamily="sans-serif"
                android:textSize="16sp"
                android:textColor="@color/neon_red"
                android:letterSpacing="0.15"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/tvPenaltyDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tu as manqué des sessions de focus.\nTes jeux sont bloqués jusqu\'à ce que tu complètes une session."
                android:textSize="13sp"
                android:textColor="#CCFF6B83"
                android:gravity="center"
                android:lineSpacingMultiplier="1.5"/>

        </LinearLayout>

        <!-- Section label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="APPLICATIONS BLOQUÉES"
            android:fontFamily="sans-serif"
            android:textSize="9sp"
            android:letterSpacing="0.25"
            android:textColor="@color/text_muted"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"/>

        <!-- Blocked Apps List -->
        <LinearLayout
            android:id="@+id/blockedAppsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"/>

        <!-- Unlock CTA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_unlock_cta"
            android:layout_margin="16dp"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Complète 1 session de focus pour débloquer toutes tes applications de jeu."
                android:textSize="13sp"
                android:textColor="@color/text_muted"
                android:gravity="center"
                android:lineSpacingMultiplier="1.5"
                android:layout_marginBottom="14dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartFocus"
                style="@style/ButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="▶ COMMENCER LE FOCUS"/>

        </LinearLayout>

        <!-- No penalty state -->
        <LinearLayout
            android:id="@+id/noPenaltyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="40dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✅"
                android:textSize="48sp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aucune pénalité active"
                android:fontFamily="sans-serif"
                android:textSize="14sp"
                android:textColor="@color/neon_green"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Continue comme ça, warrior !"
                android:textSize="12sp"
                android:textColor="@color/text_muted"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
