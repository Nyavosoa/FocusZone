<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardElevation="0dp">

    <LinearLayout
        android:id="@+id/taskItemRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top row: checkbox + name + edit/delete buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <CheckBox
                android:id="@+id/cbTask"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:button="@drawable/cb_task_selector"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:id="@+id/tvTaskName"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Nom de la mission"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_primary"
                android:lineSpacingMultiplier="1.2"/>

            <!-- Finished Badge -->
            <TextView
                android:id="@+id/tvFinishedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ TERMINÉ"
                android:textSize="8sp"
                android:textStyle="bold"
                android:textColor="@color/neon_green"
                android:background="@drawable/bg_badge_unlocked"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginEnd="8dp"
                android:visibility="gone"/>

            <ImageButton
                android:id="@+id/btnEditTask"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_edit"
                app:tint="@color/text_muted"
                android:contentDescription="Modifier"/>

            <ImageButton
                android:id="@+id/btnDeleteTask"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_delete"
                app:tint="@color/neon_red"
                android:contentDescription="Supprimer"/>

        </LinearLayout>

        <!-- Bottom row: notification + pomodoro dots -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Notification chip -->
            <LinearLayout
                android:id="@+id/notifChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_notif_chip"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔔"
                    android:textSize="10sp"/>

                <TextView
                    android:id="@+id/tvNotifLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tous les jours • 08:00"
                    android:textSize="11sp"
                    android:textColor="#E6BF00FF"
                    android:fontFamily="sans-serif"
                    android:layout_marginStart="4dp"/>

            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <!-- Custom Focus Badge -->
            <TextView
                android:id="@+id/tvCustomFocusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱ 25 min"
                android:textSize="10sp"
                android:textColor="@color/neon_cyan"
                android:background="@drawable/bg_xp_badge"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone"
                android:layout_marginEnd="8dp"/>

            <!-- Pomodoro dots -->
            <LinearLayout
                android:id="@+id/pomoDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View android:id="@+id/dot1" android:layout_width="8dp" android:layout_height="8dp"
                    android:layout_marginStart="3dp" android:background="@drawable/bg_pomo_dot"/>
                <View android:id="@+id/dot2" android:layout_width="8dp" android:layout_height="8dp"
                    android:layout_marginStart="3dp" android:background="@drawable/bg_pomo_dot"/>
                <View android:id="@+id/dot3" android:layout_width="8dp" android:layout_height="8dp"
                    android:layout_marginStart="3dp" android:background="@drawable/bg_pomo_dot"/>
                <View android:id="@+id/dot4" android:layout_width="8dp" android:layout_height="8dp"
                    android:layout_marginStart="3dp" android:background="@drawable/bg_pomo_dot"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
